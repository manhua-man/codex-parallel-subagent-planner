{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/manhua-man/codex-parallel-subagent-planner/schema/planner-plan.schema.json",
  "title": "PlannerPlan",
  "description": "Structured Planner Contract output schema for Parallel Subagent Planner (v0.2.0)",
  "type": "object",
  "required": [
    "schema_version",
    "mode",
    "budget",
    "contracts",
    "lanes",
    "frontier"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [1]
    },
    "mode": {
      "type": "string",
      "enum": ["task", "project"]
    },
    "budget": {
      "type": "object",
      "required": ["max_concurrency", "max_write_lanes", "cost_profile"],
      "additionalProperties": false,
      "properties": {
        "max_concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "max_write_lanes": {
          "type": "integer",
          "minimum": 0
        },
        "max_explorer_lanes": {
          "type": "integer",
          "minimum": 0
        },
        "cost_profile": {
          "type": "string",
          "enum": ["cheap", "balanced", "quality"]
        },
        "write_policy": {
          "type": "string",
          "enum": ["single_writer", "disjoint_only"]
        }
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "owner", "state"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": ["string", "null"]
          },
          "description": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": ["pending", "active", "integrated", "done"]
          }
        }
      }
    },
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "agent_type",
          "model_profile",
          "reasoning_profile",
          "depends_on",
          "read_scope",
          "write_scope",
          "acceptance",
          "state",
          "held_reason"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "agent_type": {
            "type": "string",
            "enum": ["explorer", "worker", "verification", "cleanup", "default"]
          },
          "model_profile": {
            "type": "string",
            "enum": ["deep", "balanced", "fast"]
          },
          "model_override": {
            "type": ["string", "null"]
          },
          "reasoning_profile": {
            "type": "string",
            "enum": ["auto", "low", "medium", "high"]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "read_scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "write_scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "deliverable": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": ["ready", "running", "blocked", "integrated", "done", "held"]
          },
          "held_reason": {
            "type": ["string", "null"],
            "enum": [
              null,
              "safe",
              "overlap",
              "blocked",
              "dependency",
              "contract",
              "unclear_scope",
              "unclear_acceptance",
              "verification_failed",
              "cost"
            ]
          },
          "launch_score": {
            "type": "number"
          },
          "score_reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "frontier": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
